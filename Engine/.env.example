# SYSTEM 2 (NIRBHAYA SANCHAR ENGINE) PRODUCTION CONFIGURATION

APP_NAME=NIRBHAYA_SANCHAR_ENGINE
ENVIRONMENT=production
API_HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database (Local SQLite or Managed Cloud PostgreSQL)
# Example PostgreSQL: postgresql+asyncpg://user:password@host:5432/nirbhaya_db
DATABASE_URL=sqlite+aiosqlite:///./nirbhaya_engine.db
REDIS_URL=

# Allowed CORS Origins (Comma-separated list of frontends)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-system1-frontend.vercel.app,https://your-system2-frontend.vercel.app

# System 1 Integration & Webhook Callbacks
SYSTEM1_BASE_URL=http://localhost:3001
SYSTEM1_CALLBACK_URL=http://localhost:3001/api/nirbhaya/callback
SYSTEM1_CALLBACK_SECRET=nirbhaya_system1_api_key_2026
INTERNAL_API_KEY=nirbhaya_internal_api_key_2026

# AI Voice Anti-Spoofing Model Settings
VOICE_MODEL_PROVIDER=PyTorch AntiSpoof LFCC-ResNet Engine
VOICE_MODEL_NAME=nirbhaya-antispoof-v1
VOICE_MODEL_VERSION=1.0.0
VOICE_MODEL_PATH=
VOICE_MODEL_LICENSE=Apache 2.0 / Open Weights

# Speaker Verification Engine
SPEAKER_MODEL=ECAPA-TDNN / Acoustic Spectral Vector
SPEAKER_MODEL_PATH=

# Speech-to-Text (ASR) Engine
ASR_PROVIDER=Nirbhaya MultiLang ASR / Whisper API
ASR_MODEL=whisper-base-multilingual
ASR_API_KEY=
ASR_API_URL=

# Production Security
JWT_SECRET=your_secure_random_jwt_secret_key_here
