APP_NAME=NIRBHAYA_SANCHAR_ENGINE
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Database (PostgreSQL for Render or SQLite for local)
DATABASE_URL=sqlite+aiosqlite:///./nirbhaya_engine.db
REDIS_URL=

# CORS Allowed Origins
CORS_ORIGINS=https://nirbhaya-sanchar-connect-vv3g.vercel.app,http://localhost:5173,http://localhost:5174,*

# System 1 Integration (Production Render URL)
SYSTEM1_BASE_URL=https://nirbhaya-connect-server.onrender.com
SYSTEM1_CALLBACK_URL=https://nirbhaya-connect-server.onrender.com/api/nirbhaya/callback
SYSTEM1_API_KEY=nirbhaya_system1_api_key_2026
SYSTEM1_CALLBACK_SECRET=nirbhaya_system1_api_key_2026

# Voice Detection Model (AASIST official pretrained weights)
VOICE_MODEL_PROVIDER=AASIST
VOICE_MODEL_NAME=AASIST
VOICE_MODEL_VERSION=ASVspoof2019-LA
VOICE_MODEL_PATH=models/AASIST.pth
VOICE_MODEL_LICENSE=MIT / NAVER Corp (Clova AI)

# Speaker Verification (ECAPA-TDNN)
SPEAKER_MODEL=ECAPA-TDNN / Acoustic Spectral Vector
SPEAKER_MODEL_PATH=

# ASR (Speech To Text)
ASR_PROVIDER=Nirbhaya MultiLang ASR / Whisper API
ASR_MODEL=whisper-base-multilingual
ASR_API_KEY=
ASR_API_URL=
GEMINI_API_KEY=

# Security
JWT_SECRET=nirbhaya_secret_key_change_in_production_2026_safe
INTERNAL_API_KEY=nirbhaya_internal_api_key_2026

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=nirbhaya_audio_temp
